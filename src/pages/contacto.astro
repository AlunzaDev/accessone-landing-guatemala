---
import InteriorLayout from '../layouts/InteriorLayout.astro';
import ContactForm from '../components/ContactForm';
import Icon from '../components/Icon';
---
<InteriorLayout title="Contacto | AccessOne Guatemala" description="Conversemos sobre la operación, tecnología y mantenimiento de tu parqueo en Guatemala.">
  <section class="page-hero contact-hero"><p class="tag">Contacto</p><h1>Tu siguiente proyecto empieza aquí.</h1><p>Conversemos sobre cómo mejorar la operación y experiencia de tu parqueo en Guatemala.</p></section>
  <section class="contact-directory" aria-labelledby="contact-directory-title">
    <div class="directory-heading"><p class="tag">AccessOne Guatemala</p><h2 id="contact-directory-title">Estamos para apoyarte.</h2><p>Contacta a nuestro representante para conversar sobre tu proyecto.</p></div>
    <div class="directory-grid">
      <article><span aria-hidden="true"><Icon name="support" className="contact-icon" /></span><p>Representante</p><strong>Caín Roberto Castañeda Galicia</strong><small>AccessOne Guatemala</small></article>
      <article><span aria-hidden="true"><Icon name="mail" className="contact-icon" /></span><p>Correo electrónico</p><a href="mailto:ccastaneda@accessone.com.mx">ccastaneda@accessone.com.mx</a></article>
      <article><span aria-hidden="true"><Icon name="phone" className="contact-icon" /></span><p>Teléfono</p><a href="tel:+524433333330;ext=164">443 333 3330 Ext. 164</a></article>
      <article><span aria-hidden="true"><Icon name="phone" className="contact-icon" /></span><p>Celular</p><a href="tel:+523312690117">+52 331 269 0117</a></article>
    </div>
  </section>
  <section class="contact-form-section"><ContactForm client:load /></section>
</InteriorLayout>
